---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#f7f3ef">
  <meta name="description" content="DR Florist Kalibata — toko bunga di Pancoran, Jakarta Selatan. Buka 24 jam. Hubungi 0819-1221-8337.">
  <title>DR Florist Kalibata — Hadiah yang Tumbuh dari Rasa</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--ink:#282522;--muted:#77736e;--paper:#f7f3ef;--white:#fffdfa;--wine:#754250;--wine2:#5b303d;--pink:#ead2d0;--sage:#a6ad91;--line:#e6ded8;--gold:#b9945d}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif;line-height:1.65}a{color:inherit;text-decoration:none}.wrap{width:min(1140px,calc(100% - 48px));margin:auto}.topline{background:var(--wine2);color:#f7efeb;padding:8px 0;font-size:10px;text-transform:uppercase;letter-spacing:.15em}.topline .wrap{display:flex;justify-content:space-between}.header{height:80px;display:flex;align-items:center}.nav{display:flex;align-items:center;justify-content:space-between;width:100%}.brand{display:flex;align-items:center;gap:12px;font-family:'Playfair Display',serif;font-size:20px;font-weight:600}.brand-icon{width:40px;height:40px;border:1px solid var(--wine);color:var(--wine);border-radius:50%;display:grid;place-items:center;font-size:20px}.brand small{display:block;font:600 9px 'DM Sans',sans-serif;color:var(--muted);text-transform:uppercase;letter-spacing:.18em}.navlinks{display:flex;gap:29px;font-size:12px;color:#625f59}.navlinks a:hover{color:var(--wine)}.navcall{border:1px solid var(--wine);padding:10px 16px;color:var(--wine);font-size:12px;font-weight:700;border-radius:99px}.navcall:hover{background:var(--wine);color:white}
    .hero{padding:26px 0 78px}.hero-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:60px;align-items:center}.copy{padding:20px 0}.eyebrow{color:var(--wine);font-size:10px;text-transform:uppercase;letter-spacing:.2em;font-weight:700;display:flex;align-items:center;gap:10px}.eyebrow:before{content:'';width:26px;height:1px;background:var(--gold)}h1,h2,h3{font-family:'Playfair Display',serif;line-height:1.08;font-weight:500}h1{font-size:clamp(49px,6.5vw,76px);letter-spacing:-.04em;margin:20px 0}h1 em{color:var(--wine)}.copy p{font-size:15px;color:var(--muted);max-width:430px;line-height:1.85;margin:0 0 26px}.actions{display:flex;gap:12px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--wine);color:white;border-radius:4px;padding:14px 19px;font-size:12px;font-weight:700;transition:.2s}.button:hover{background:var(--wine2);transform:translateY(-1px)}.button-alt{background:transparent;color:var(--wine);border:1px solid #c9b6b3}.button-alt:hover{background:white;color:var(--wine)}.rating{display:flex;align-items:center;gap:10px;margin-top:28px;font-size:12px;color:var(--muted)}.stars{color:var(--gold);letter-spacing:2px}.rating b{color:var(--ink)}.hero-art{height:500px;position:relative}.hero-photo{position:absolute;inset:0 36px 28px 0;border-radius:220px 220px 4px 4px;overflow:hidden;background:#dfd2c8}.hero-photo img{width:100%;height:100%;object-fit:cover;display:block}.float-photo{position:absolute;right:0;bottom:0;width:190px;height:190px;border:8px solid var(--paper);border-radius:50%;object-fit:cover}.stamp{position:absolute;left:-20px;top:75px;width:100px;height:100px;border-radius:50%;background:var(--sage);color:white;display:grid;place-items:center;text-align:center;font:600 11px 'Playfair Display',serif;line-height:1.3;transform:rotate(-10deg)}.photo-label{position:absolute;bottom:47px;left:18px;background:rgba(255,253,250,.92);padding:9px 13px;font-size:9px;text-transform:uppercase;letter-spacing:.13em;color:var(--wine);font-weight:700}
    .info-strip{background:var(--pink);padding:20px 0}.info-row{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.info{display:flex;gap:12px;align-items:center;font-size:11px;color:#6e625e}.info-icon{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.6);color:var(--wine);font-size:16px}.info b{display:block;color:#392d2c;font-size:12px}
    .section{padding:88px 0}.section-head{display:grid;grid-template-columns:1fr .8fr;gap:35px;align-items:end;margin-bottom:34px}.section-head .eyebrow{grid-column:1/-1;margin-bottom:-20px}.section-head h2{font-size:clamp(38px,5vw,58px);margin:0}.section-head p{font-size:13px;color:var(--muted);margin:0;max-width:390px}.gallery{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}.gallery-item{position:relative;min-height:280px;overflow:hidden;background:#e5d8d1}.gallery-item:first-child{grid-row:span 2;min-height:575px}.gallery-item img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s}.gallery-item:hover img{transform:scale(1.04)}.gallery-item:after{content:'';position:absolute;inset:55% 0 0;background:linear-gradient(transparent,rgba(38,28,28,.5))}.gallery-label{position:absolute;left:15px;bottom:13px;z-index:1;color:white;font-family:'Playfair Display',serif;font-size:18px}.gallery-note{font-size:10px;color:#89817b;margin-top:12px}
    .note-band{background:var(--wine);color:#fff8f5;padding:67px 0}.note-grid{display:grid;grid-template-columns:.45fr 1.55fr;gap:40px;align-items:center}.note-symbol{font-family:'Playfair Display',serif;color:var(--pink);font-size:120px;line-height:1;text-align:center}.note-band .eyebrow{color:#e9d4c6}.note-band .eyebrow:before{background:var(--gold)}.note-band h2{font-size:clamp(37px,5vw,55px);margin:14px 0}.note-band p{font-size:14px;color:#e4d4d1;max-width:650px;line-height:1.85;margin:0}
    .visit{padding:87px 0}.visit-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px}.visit h2{font-size:clamp(40px,5vw,57px);margin:15px 0}.visit-intro p{color:var(--muted);font-size:13px;max-width:340px}.reviewbox{display:flex;align-items:center;gap:13px;margin-top:22px}.reviewbox strong{font:600 38px 'Playfair Display',serif;color:var(--wine)}.reviewbox span{color:var(--muted);font-size:11px}.details{border-top:1px solid var(--line)}.row{display:grid;grid-template-columns:95px 1fr;gap:15px;padding:16px 0;border-bottom:1px solid var(--line);font-size:12px}.row dt{color:var(--muted)}.row dd{margin:0;font-weight:600;line-height:1.75}.visit-actions{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:22px}.subtle-link{font-size:12px;color:var(--wine);font-weight:700;border-bottom:1px solid #c7adae;padding:8px 0}.footer{border-top:1px solid var(--line);padding:23px 0;color:#827a74;font-size:10px}.footer-row{display:flex;justify-content:space-between;gap:15px}.footer b{color:var(--wine);font-family:'Playfair Display',serif;font-size:14px}
    @media(max-width:820px){.wrap{width:min(100% - 38px,650px)}.navlinks{display:none}.hero{padding:10px 0 55px}.hero-grid{grid-template-columns:1fr;gap:22px}.hero-art{height:410px;grid-row:1}.hero-photo{inset:0 30px 25px 20px}.float-photo{width:150px;height:150px}.stamp{left:0;top:50px;width:82px;height:82px;font-size:10px}.copy{padding:3px 0}.section{padding:68px 0}.section-head{grid-template-columns:1fr;gap:12px}.section-head .eyebrow{margin:0}.gallery{grid-template-columns:1fr 1fr}.gallery-item:first-child{grid-row:auto;grid-column:span 2;min-height:380px}.gallery-item{min-height:220px}.note-grid{grid-template-columns:1fr;gap:20px}.note-symbol{text-align:left;font-size:90px}.visit-grid{grid-template-columns:1fr;gap:25px}.footer-row{flex-direction:column}}
    @media(max-width:470px){.wrap{width:calc(100% - 30px)}.topline{font-size:8px}.topline .wrap span:last-child{display:none}.header{height:68px}.brand{font-size:17px}.navcall{padding:9px 12px;font-size:10px}.hero-art{height:330px}.hero-photo{inset:0 24px 20px 12px}.float-photo{width:120px;height:120px;border-width:6px}.stamp{width:70px;height:70px;font-size:9px}.photo-label{bottom:34px;font-size:8px}.info-row{grid-template-columns:1fr 1fr;gap:13px}.info:last-child{grid-column:span 2}.info{font-size:10px}.info b{font-size:11px}.info-icon{width:32px;height:32px}.section-head h2{font-size:40px}.gallery{gap:8px}.gallery-item:first-child{min-height:300px}.gallery-item{min-height:170px}.gallery-label{left:10px;bottom:9px;font-size:15px}.note-band{padding:52px 0}.note-band h2{font-size:39px}.row{grid-template-columns:72px 1fr;gap:10px;font-size:11px}}
  </style>
</head>
<body>
  <slot />
</body>
</html>
